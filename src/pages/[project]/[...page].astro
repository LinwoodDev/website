---
import BlogList from "@components/BlogList.astro";
import { getCollection } from "astro:content";
import { getEntriesCacheKey, getPosts, getProjects } from "../../blog";
import DefaultLayout from "../../layouts/DefaultLayout.astro";
import ProjectHero from "@components/ProjectHero.astro";
import { PAGE_SIZE } from "../blog/[...page].astro";
import type { PaginateFunction } from "astro";

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction;
}) {
  const projects = await getProjects(true);
  const authors = new Map(
    (await getCollection("authors")).map((author) => [author.id, author])
  );
  return (
    await Promise.all(
      projects.map(async (project) => {
        const posts = (await getPosts()).filter((post) =>
          post.id.startsWith(project.id)
        );
        return paginate(posts, {
          pageSize: PAGE_SIZE,
          params: { project: project.id },
          props: { project: project },
        }).map((path) => {
          const { page } = path.props;
          const pageAuthors = page.data
            .map((post) => authors.get(post.data.author.id))
            .filter((author) => author !== undefined);
          return {
            ...path,
            cacheKey: `${page.currentPage}/${page.lastPage}/${page.total}:${getEntriesCacheKey([
              project,
              ...page.data,
              ...pageAuthors,
            ])}`,
          };
        });
      })
    )
  ).flat();
}

const { page, project } = Astro.props;
---

<DefaultLayout title={project.data.title}>
  <section>
    <ProjectHero project={project.id} />
  </section>
  <section>
    <h2>Blog</h2>
    <BlogList page={page} />
  </section>
</DefaultLayout>
